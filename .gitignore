# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
devserver.log
# logs descartables de ejecuciones locales
codex_*.log
srv_*.log
next_dev_*.log

# claude code (config local)
.claude/

# scripts de prueba descartables
scripts/_*.mjs

# MP3 de muestra que genera scripts/probar-voz-lucia.mjs
audio-prueba/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.zip
out.zip
out.zip
out.zip
out.zip
*.zip
out.zip
*.zip

# audios crudos del TTS: se comprimen a public/podcast/ y no se versionan
/audios-nuevos/

# videos de propiedades: los genera scripts/video-propiedad.mjs a partir de las
# fotos, así que son artefactos derivados. Versionarlos sumaba ~7 MB de binarios
# al historial en cada regeneración y ninguna página del sitio los consume.
# Para recrearlos: node scripts/video-propiedad.mjs
/public/videos/

# Datos de la revision diaria de analitica (se regeneran, no van al repo)
revision-web.json

# Notas de trabajo y archivos temporales de sesion (ver _ARCHIVOS_SUELTOS.md)
_ARCHIVOS_SUELTOS.md
_prueba
_admin_check.png
*.log
docs/debug-ficha.html

# Carpeta de descarte: cosas que esperan confirmacion para borrarse. Llego a
# tener 76 MB de tarballs y locks viejos, y un `git add .` distraido los mete
# al historial para siempre.
/_to_delete/

# Crudos del podcast. A public/podcast/ va SOLO el mp3 comprimido que sirve el
# sitio (64 kbps mono); el .m4a de origen pesa entre 40 y 55 MB. El .gitignore
# ya cubria /audios-nuevos/, pero los crudos que se dejan al lado del mp3
# quedaban afuera del patron.
/public/podcast/*.m4a

# El audio de la nota "cuanto necesitas para comprar", que salio de linea el
# 2026-08-24 porque narra los montos viejos (la comision con IVA que no se
# cobra, y el sellos partido 50/50 cuando lo paga entero el comprador). Se
# deja en disco por si la nota vuelve, pero no se publica: hasta hoy seguia
# sirviendose en produccion aunque ya no lo enlazara nadie. Si la nota vuelve
# corregida, hay que regenerarlo antes de volver a versionarlo.
/public/podcast/cuanto-necesitas-para-comprar-en-san-martin-de-los-andes.mp3

# Salidas de la suite end-to-end (Playwright): trazas, capturas y videos de las
# corridas fallidas, y el reporte HTML del CI. Se regeneran en cada corrida y
# pesan; al repo va la suite, no sus resultados.
/test-results/
/playwright-report/

# Artefactos de las sesiones de trabajo: puntos de retorno del hero con sus
# .mp4, los snapshots de verificar-fotos.mjs y borradores de investigacion. Son
# 25 MB que se regeneran y que ninguna pagina del sitio consume, y los puntos de
# retorno solo sirven mientras dura la sesion que los creo. Siguen en disco: lo
# que no queda es su copia en el historial.
/outputs/
/Claude outputs/

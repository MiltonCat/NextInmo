  "edges": [
    {
      "id": "abre",
      "from": "visitante",
      "to": "wizard",
      "label": "abre /tasacion",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "cuenta",
      "from": "charla",
      "to": "interpretar",
      "label": "manda la charla",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "precarga",
      "from": "interpretar",
      "to": "wizard",
      "label": "precarga los pasos",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "envia",
      "from": "wizard",
      "to": "api",
      "label": "envía los 5 pasos",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "ratelimit",
      "from": "api",
      "to": "limite",
      "label": "corta el raspado",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "chequea",
      "from": "api",
      "to": "muro",
      "label": "¿tiene derecho?",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "sinnada",
      "from": "muro",
      "to": "bloqueado",
      "label": "sin correo ni sesión",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "pide",
      "from": "api",
      "to": "modeloapi",
      "label": "POST /tasar",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "devuelve",
      "from": "modeloapi",
      "to": "resultado",
      "label": "valor + rango",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "contexto",
      "from": "mercado",
      "to": "resultado",
      "label": "contexto del barrio",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "imprime",
      "from": "resultado",
      "to": "pdf",
      "label": "si lo pide",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "guarda",
      "from": "resultado",
      "to": "guardar",
      "label": "si hay sesión",
      "variant": "dashed",
      "role": "async"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Las reglas del muro",
      "items": [
        "La primera es libre; de la segunda, hace falta un correo",
        "Con sesión no hay muro y la tasación queda guardada",
        "El correo entra a la lista y recibe la bienvenida"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lo que no se ve",
      "items": [
        "Al abrir el formulario ya se despierta el contenedor",
        "La lista de barrios corta a los 8 s y cae a la del repo",
        "La profesional es el mismo camino, con 4 ciudades"
      ]
    }
  ]
}
          "label": "En el servidor"
        },
        "database": {
          "label": "Datos guardados"
        },
        "cloud": {
          "label": "Servicios externos"
        },
        "security": {
          "label": "Cortes y muro"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "directo",
      "label": "Entrada directa"
    },
    {
      "id": "elmodelo",
      "label": "El modelo predictivo · Render"
    },
    {
      "id": "porlucia",
      "label": "Entrada por Lucía"
    },
    {
      "id": "sitio",
      "label": "El sitio · Next.js en Vercel"

    {
      "id": "pdf",
      "lane": "directo",
      "col": 5,
      "type": "backend",
      "label": "PDF",
      "sublabel": "se lo lleva impreso",
      "width": 150
    },
    {
      "id": "modeloapi",
      "lane": "elmodelo",
      "col": 3,
